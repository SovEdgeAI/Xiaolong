# === RA3 Threat Response System — environment template ===
# Copy this file to `.env` and fill in real values before `docker compose up`.

# OpenAI-compatible LLM provider (works with third-party proxies).
OPENAI_API_KEY=your_api_key_here
# Base URL of the provider's OpenAI-compatible API (must include /v1).
OPENAI_BASE_URL=https://huodingai.com/v1
# Model id to use for the decision engine.
# Set to `mock` to run the whole pipeline offline with a built-in rule-based
# decision engine (no external API call) — useful when the provider is down.
LLM_MODEL=gpt-5.5

# Async SQLAlchemy connection string. The hostname `db` matches the
# docker-compose service name; keep it as-is when running via compose.
DATABASE_URL=postgresql+asyncpg://ra3:ra3pass@db:5432/ra3db

# Logging verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# URL the client simulator uses to reach the server (compose-internal by default)
RA3_SERVER_URL=http://server:8000

# --- Action execution (MCP + ephemeral executor containers) ---
# MCP server endpoint the RA3 server connects to as an MCP client.
MCP_SERVER_URL=http://mcp:9000/mcp
# Set to false to run in decision-only mode (skip actually executing actions).
EXECUTION_ENABLED=true
# Image + memory cap for the one-shot executor containers launched per action.
EXECUTOR_IMAGE=ra3-executor:latest
EXECUTOR_MEM_LIMIT=128m
