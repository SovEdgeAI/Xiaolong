# === RA3 Threat Response System — environment template ===
# Copy this file to `.env` and fill in real values before `docker compose up`.

# OpenAI-compatible LLM provider (works with third-party proxies).
OPENAI_API_KEY=your_api_key_here
# Base URL of the provider's OpenAI-compatible API (must include /v1).
OPENAI_BASE_URL=https://huodingai.com/v1
# Model id to use for the decision engine.
# Set to `mock` to run the whole pipeline offline with a built-in rule-based
# decision engine (no external API call) — useful when the provider is down.
LLM_MODEL=gpt-5.5

# Async SQLAlchemy connection string. The hostname `db` matches the
# docker-compose service name; keep it as-is when running via compose.
DATABASE_URL=postgresql+asyncpg://ra3:ra3pass@db:5432/ra3db

# Logging verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# URL the client simulator uses to reach the server (compose-internal by default)
RA3_SERVER_URL=http://server:8000
# Client timeout for POST /report (raise to ~600 with LLM_MODEL=anyjev on CPU)
RA3_REQUEST_TIMEOUT=60

# --- Action execution (MCP + ephemeral executor containers) ---
# MCP server endpoint the RA3 server connects to as an MCP client.
MCP_SERVER_URL=http://mcp:9000/mcp
# Set to false to run in decision-only mode (skip actually executing actions).
EXECUTION_ENABLED=true
# Image + memory cap for the one-shot executor containers launched per action.
EXECUTOR_IMAGE=ra3-executor:latest
EXECUTOR_MEM_LIMIT=128m

# --- Local open-source decision model (LLM_MODEL=anyjev) ---
# Each candidate action is a yes/no question read from the model's logits via
# AnyJev; actions with P(yes) >= JEV_THRESHOLD are selected (1..N per alert).
# Needs: pip install -r server/requirements-jev.txt, or in Docker:
#   WITH_JEV=true LLM_MODEL=anyjev docker compose up -d --build
# Build the server image with torch + AnyJev
WITH_JEV=false
# Host Hugging Face cache mounted into the server container (weights live here)
HF_CACHE_DIR=~/.cache/huggingface
HF_HUB_OFFLINE=1
SERVER_MEM_LIMIT=12g
JEV_MODEL=Qwen/Qwen3-4B
JEV_DEVICE=cpu
JEV_DTYPE=bfloat16
# CPU threads for torch (empty/0 = 3/4 of cores; all cores is much slower)
JEV_THREADS=
JEV_THRESHOLD=0.5
# none | batch | content_free — label prior correction (none = deterministic)
JEV_PRIOR=none
# L1 temperature artifacts from scripts/jev_calibrate.py (empty = L0 only)
# Host-side path for scripts/venv runs; the server container always reads
# /app/artifacts/jev_artifacts.json (./artifacts mounted read-only)
JEV_ARTIFACTS=
# Highest level to serve from those artifacts: L0 | L1 | L2 (each question falls back if it has none)
JEV_MAX_LEVEL=L2
# Only ask actions whose catalog applicable_threats include the attack type
JEV_RESTRICT_TO_CATALOG=true
# Generate structured English rationales (JSON) with the same model (slow on CPU)
JEV_EXPLAIN=true
JEV_EXPLAIN_MAX_TOKENS=384

# --- Fine-tuning jobs for the local decision model (POST /training/jobs) ---
# Not a response action: runs in a detached trainer container beside alert handling.
FINETUNE_ENABLED=true
# Base model to fine-tune (default: JEV_MODEL)
FINETUNE_BASE_MODEL=
# Labeled data file under ./artifacts
FINETUNE_DATASET=teacher_labels.jsonl
# Auto trigger: start a job every N reported incidents (0 = manual only)
FINETUNE_TRIGGER_EVERY=0
FINETUNE_AUTO_MODE=dry_run
# Trainer container: image, memory cap, GPU passthrough (needs a GPU trainer image)
TRAINER_IMAGE=ra3-trainer:latest
TRAINER_MEM_LIMIT=2g
TRAINER_GPU=false

# --- Execution against the 5G SDN DDoS testbed (optional) ---
# mock (default): executor simulates actions, network-isolated.
# testbed: executor enforces on the testbed via the testbed-agent.
EXECUTOR_MODE=mock
AGENT_URL=http://172.17.0.1:8090
TESTBED_UE_IP=10.45.0.3
