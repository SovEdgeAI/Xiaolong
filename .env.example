# Integration-level configuration (copy to .env; never commit real keys).
# RA3's own config template is ra3-respond/.env.example.

# --- Enforcement backend -----------------------------------------------------
EXECUTOR_MODE=testbed                       # mock | testbed
AGENT_URL=http://172.17.0.1:8090            # the testbed-agent RA3 drives
TESTBED_UE_IP=10.45.0.3                      # the compromised UE on the testbed

# --- Decision model ----------------------------------------------------------
WITH_JEV=true
LLM_MODEL=anyjev                             # anyjev (local Qwen3-4B) | mock
JEV_MODEL=Qwen/Qwen3-4B                       # downloaded from Hugging Face at runtime
JEV_MAX_LEVEL=L2                             # L0 | L1 | L2
JEV_EXPLAIN=false                            # English rationale generation (slower)

# --- Only needed if LLM_MODEL points at a hosted API (not anyjev) ------------
# OPENAI_API_KEY=sk-...                      # DO NOT commit a real key
# OPENAI_BASE_URL=https://api.openai.com/v1
